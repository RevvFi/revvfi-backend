# ==============================================================
# .env.example  –  RevvFi Backend environment template
# Copy to .env.local (local dev) or a testnet/production env file
# and fill in real values. Never commit real secrets to git.
#
# Precedence: real environment variables > .env.local > .env
# (see internal/config/config.go's Load())
# ==============================================================

# ------------------------------------------------------------
# MUST CHANGE for testnet/production
# ------------------------------------------------------------

ENVIRONMENT=production                # "development" enables verbose/dev-only behavior

# --- Database (Supabase Postgres) ---
# Recommended: set only DATABASE_URL (or DB_URL) and leave the discrete DB_*
# vars below empty — config.go prefers DATABASE_URL/DB_URL over them, and
# postgresURLWithSSL() auto-appends sslmode=require if you don't set one.
#
# Get this from Supabase dashboard -> Project Settings -> Database ->
# Connection string -> URI. Use the "Session pooler" (or "Direct connection")
# string, NOT the "Transaction pooler" (port 6543) — this app keeps its own
# long-lived connection pool (DB_MAX_CONN below), which doesn't play well
# with pgbouncer's transaction-mode multiplexing.
DATABASE_URL=                         # postgres://postgres.<ref>:<password>@<host>:5432/postgres?sslmode=require

# Discrete fallback vars (only used if DATABASE_URL/DB_URL is empty):
DB_HOST=                              # real Postgres host, NOT localhost
DB_PORT=5432
DB_USER=                              # real DB user, NOT postgres
DB_PASSWORD=                          # real DB password
DB_NAME=revvfi_db
DB_SSL_MODE=require                   # NOT disable — testnet/prod DB should require TLS

# --- Auth / security ---
JWT_SECRET=                           # generate a real random 32+ byte secret — do NOT use the dev default
CORS_ALLOWED_ORIGINS=                 # comma-separated real frontend origin(s), e.g. https://app.revvfi.com

# --- Blockchain ---
RPC_URL=                              # real Sepolia (or target testnet) RPC URL
CHAIN_ID=11155111                     # Sepolia. Match whatever testnet you're actually deploying to.
ARTIFACT_PATH=                        # path to revvfi-contracts/out on THIS host (not a hardcoded dev machine path)
INDEXER_START_BLOCK=                  # the contracts' actual deployment block on this chain — NOT 0
                                       # (0 means scanning from genesis, which is extremely slow and will
                                       # likely hit RPC provider rate limits on a real chain)

# --- Deployed contract addresses (fill in after running the contracts deploy script) ---
FACTORY_ADDRESS=
ARCH_CONTROLLER_ADDRESS=
POSITION_NFT_ADDRESS=
LIQUIDATOR_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
# MARKET_ADDRESS / OFFERBOOK_ADDRESS / COLLATERAL_ESCROW_ADDRESS are intentionally
# left unset — the indexer discovers per-market clone addresses dynamically via
# MarketDeployed events, it doesn't need them pre-configured.

# --- SIWE auth (must match the deployed frontend + chain) ---
AUTH_DOMAIN=                          # real frontend domain, e.g. app.revvfi.com
AUTH_URI=                             # real frontend login URL, e.g. https://app.revvfi.com/api/v1/auth/login
AUTH_CHAIN_ID=11155111                # must match CHAIN_ID above

# --- Admin wallets ---
ADMIN_WALLETS=                        # comma-separated real admin wallet addresses (not local test accounts)

# ------------------------------------------------------------
# Safe defaults (rarely need changing)
# ------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8080
API_BASE_PATH=/api/v1
API_SHUTDOWN_TIMEOUT=10s

DB_MAX_CONN=25
DB_MIN_CONN=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

JWT_EXPIRY=86400
JWT_ISSUER=revvfi

CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-Correlation-ID

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m

MULTICALL_ADDRESS=

# Reorg safety margin in blocks before the indexer treats a block as final.
# 0 is fine for a private single-node chain (e.g. local Anvil) but should be
# a non-zero value (e.g. 3-6) on a real public testnet where small reorgs happen.
BLOCK_CONFIRMATIONS=3
SYNC_BLOCK_INTERVAL=3s
MAX_BLOCK_BATCH_SIZE=100

AUTH_STATEMENT=Sign in to RevvFi Protocol
AUTH_VERSION=1
AUTH_NONCE_TTL=5m
AUTH_SESSION_TTL=24h
